# Defaults to /api so a same-origin reverse proxy or bundled backend works.
VITE_API_BASE_URL=/api

# Defaults to same-origin /api/ws. Configure this for a separately hosted API.
# Example: ws://localhost:8080/api/ws
VITE_WS_BASE_URL=

# Optional URL for a reviewed public Excel import template.
VITE_CHECKLIST_TEMPLATE_URL=
